NODE_ENV=development
PORT=3000
API_PREFIX=api
CORS_ORIGINS=http://localhost:5173

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=vioai
DATABASE_PASSWORD=vioai_dev_password
DATABASE_NAME=vioai
DATABASE_SYNCHRONIZE=false
DATABASE_LOGGING=false
DATABASE_SSL=false

JWT_ACCESS_SECRET=change_me_with_a_32_char_minimum_secret_value
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_me_with_another_32_char_minimum_secret
JWT_REFRESH_EXPIRES_IN=7d

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5
OPENROUTER_TIMEOUT_MS=90000
OPENROUTER_REFERER=http://localhost:5173
OPENROUTER_TITLE=VioAI

EMBEDDING_ENABLED=true
EMBEDDING_MODEL=Xenova/paraphrase-multilingual-MiniLM-L12-v2
