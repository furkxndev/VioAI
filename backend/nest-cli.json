{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "plugins": [
      "@nestjs/swagger"
    ],
    "assets": [
      {
        "include": "database/seeds/*.json",
        "outDir": "dist"
      }
    ]
  },
  "generateOptions": {
    "spec": false
  }
}